# Copy to .env.local for local development. All of them are optional — the game runs fully offline without them.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_ADMIN_EMAIL=gregoire.ftn@gmail.com
# Push notifications (docs/25-PUSH-NOTIFICATIONS.md): the VAPID public key. Make a pair with
# `npx web-push generate-vapid-keys`; the private half goes to the sender only (Netlify's VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=
