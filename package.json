{
  "name": "pokedice",
  "private": true,
  "version": "1.0.0",
  "description": "Pokédice — a dice-battler fan game over the original 151. Personal, non-commercial.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "seed": "tsx scripts/seed.ts",
    "seed-regions": "tsx scripts/seed-regions.ts",
    "haunted-hollow": "tsx scripts/content-haunted-hollow.ts",
    "seed-sql": "tsx scripts/write-seed-sql.ts",
    "seed-forms": "tsx scripts/seed-forms.ts",
    "talents": "tsx scripts/hidden-talents.ts",
    "rebattle-teams": "tsx scripts/rebattle-teams.ts",
    "versus-bots": "tsx scripts/versus-bots.ts",
    "rebattle-sql": "tsx scripts/rebattle-sql.ts",
    "remove-league-ii": "tsx scripts/remove-league-ii.ts",
    "raid-overhaul-balance": "tsx scripts/raid-overhaul-balance.ts",
    "raid-balance": "tsx scripts/raid-balance.ts",
    "portal-balance": "tsx scripts/portal-balance.ts",
    "nightmare-balance": "tsx scripts/nightmare-balance.ts",
    "raid-areas": "tsx scripts/raid-areas.ts",
    "progress-raids-sql": "tsx scripts/progress-raids-sql.ts",
    "art": "tsx scripts/art.ts",
    "unpixel": "tsx scripts/unpixel.ts",
    "showdown-sprites": "tsx scripts/showdown-sprites.ts",
    "sprites-mirror": "tsx scripts/sprites-mirror.ts",
    "egg-groups": "tsx scripts/egg-groups.ts",
    "trainer-sprites": "tsx scripts/trainer-sprites.ts",
    "region-trainers": "tsx scripts/region-trainers.ts",
    "pokemon-sprites": "tsx scripts/pokemon-sprites.ts",
    "underground-sprites": "tsx scripts/underground-sprites.ts",
    "item-sprites": "tsx scripts/item-sprites.ts",
    "app-icons": "tsx scripts/app-icons.ts",
    "og-image": "node design/og-image/render.mjs",
    "sim": "tsx scripts/sim.ts",
    "balance": "tsx scripts/balance.ts",
    "area-versus-balance": "tsx scripts/area-versus-balance.ts",
    "import-bundle": "tsx scripts/import-bundle.ts",
    "pull-remote": "tsx scripts/pull-remote.ts",
    "sync": "pnpm pull-remote --write && pnpm seed-regions && pnpm seed-forms && pnpm seed-sql && pnpm test && node -e \"console.log('\\n==============================================\\n  SYNC OK - your data now matches Supabase, with Paldea added.\\n  Next: Supabase -> SQL Editor -> paste supabase/seed.sql -> Run\\n==============================================')\"",
    "i18n:names": "tsx scripts/i18n-names.ts",
    "i18n:fonts": "tsx scripts/i18n-fonts.ts",
    "bake:dice": "tsx scripts/bake-dice.ts",
    "e2e": "playwright test",
    "discord": "tsx scripts/discord/setup.ts",
    "discord:raid": "tsx scripts/discord/raid-post.ts",
    "discord:patch-notes": "tsx scripts/discord/patch-notes.ts",
    "discord:support": "tsx scripts/discord/support-post.ts",
    "discord:live": "tsx scripts/discord/live-event-post.ts",
    "discord:live-week": "tsx scripts/discord/live-week-post.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "framer-motion": "^11.11.0",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "web-push": "3.6.7",
    "zod": "^3.23.8",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.2.17",
    "@eslint/js": "^9.13.0",
    "@fontsource/fusion-pixel-12px-proportional-jp": "^5.3.0",
    "@fontsource/fusion-pixel-12px-proportional-kr": "^5.3.0",
    "@fontsource/fusion-pixel-12px-proportional-sc": "^5.3.0",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^2.1.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "globals": "^15.11.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "subset-font": "^2.9.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
